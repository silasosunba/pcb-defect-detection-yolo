# All paths are relative to the repository root. Copy this file to .env.
# Neon Console > Connect > pooled PostgreSQL connection string. Keep it server-side.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
PCB_DATA_DIR=./data
PCB_MODEL_PATH=./models/best.pt
PCB_MODEL_MANIFEST=./models/model-manifest.json
PCB_IMAGE_SIZE=1024
PCB_DEVICE=cpu
# Set true behind HTTPS in production.
PCB_SECURE_COOKIES=false
PCB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
